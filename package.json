{
  "name": "@byc/vp-config",
  "version": "0.2.0",
  "description": "YanChenBai's opinionated Vite+ config preset: fmt, lint, staged and run. Fmt and lint presets also work standalone with Oxfmt and Oxlint.",
  "keywords": [
    "oxfmt",
    "oxlint",
    "vite-plus"
  ],
  "homepage": "https://github.com/YanChenBai/vp-config#readme",
  "bugs": {
    "url": "https://github.com/YanChenBai/vp-config/issues"
  },
  "license": "MIT",
  "author": "YanChenBai (https://github.com/YanChenBai)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanChenBai/vp-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./fmt": "./dist/fmt.mjs",
    "./lint": "./dist/lint.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run cpack",
    "changeset": "changeset",
    "check": "vp run ccheck",
    "dev": "vp pack --watch",
    "prepare": "vp config",
    "release": "changeset publish",
    "test": "vp run ctest",
    "version": "changeset version && vp fmt"
  },
  "dependencies": {
    "@oxlint-flat-config/composer": "^0.3.1",
    "oxlint-flat-config": "^0.4.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@stylistic/eslint-plugin": ">=5.0.0",
    "oxfmt": ">=0.78.0",
    "oxlint": ">=1.93.0",
    "vite-plus": ">=1.6.0"
  },
  "peerDependenciesMeta": {
    "@stylistic/eslint-plugin": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "inlinedDependencies": {
    "yaml": "2.9.1"
  }
}
